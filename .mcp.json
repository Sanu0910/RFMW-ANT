{
  "mcpServers": {
    "solidcraft": {
      "type": "stdio",
      "command": "solidcraft-cli",
      "args": ["mcp", "--allow-path", "."],
      "env": {}
    },
    "kicad": {
      "type": "stdio",
      "command": "sh",
      "args": ["tools/mcp/kicad.sh"],
      "env": {}
    },
    "hertzon": {
      "type": "stdio",
      "command": "sh",
      "args": ["tools/mcp/hertzon.sh"],
      "env": {}
    }
  }
}
