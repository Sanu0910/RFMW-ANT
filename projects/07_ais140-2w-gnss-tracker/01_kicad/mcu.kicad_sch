	(text
		"DESIGN NOTES\nESP32-S3: native USB (IO19/20) gives flashing + JTAG + CDC log without extra parts.\nTC2050 Tag-Connect for production JTAG/UART; BOOT/RESET buttons for bench use.\nStrapping: IO0 boot (pull-up), IO45 LED to GND (VDD_SPI=3.3 V ok), IO46 held low by R50.\nRTC-capable wake pins: IO5 IGN, IO6 PANIC, IO14 IMU INT, IO18 modem RI."
		(exclude_from_sim no)
		(at 20 156.21 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "08edc749-145e-538a-a13e-47d72677f4bf")
	)
	(text
		"PART NOTES (VERIFY = check against vendor datasheet before release)\nU8: Quad PSRAM keeps IO35-37 free"
		(exclude_from_sim no)
		(at 219.71 156.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
