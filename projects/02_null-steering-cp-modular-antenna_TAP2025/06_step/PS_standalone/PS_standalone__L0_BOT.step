#10243 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#10244 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#10241,
  'distance_accuracy_value','confusion accuracy');
#10245 = CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#10246,#10248);
#10246 = ( REPRESENTATION_RELATIONSHIP('','',#9909,#10) 
REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#10247) 
SHAPE_REPRESENTATION_RELATIONSHIP() );
#10247 = ITEM_DEFINED_TRANSFORMATION('','',#11,#35);
