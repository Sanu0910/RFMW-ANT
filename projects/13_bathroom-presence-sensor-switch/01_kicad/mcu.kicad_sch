	(text
		"DESIGN NOTES\nATtiny13A-SU at 5 V, internal 9.6 MHz RC. 1 kB flash. Everything on this sheet is SELV (isolated 5 V).\nPB5=RESET (ISP), PB3/ADC3=delay trimmer, PB4=radar OUT, PB0=opto drive, PB1=LED, PB2=button.\nISP header J2 is the standard 6-pin AVR pinout. C3 (RESET cap) is DNP so ISP timing is clean.\nProgram the board on the bench with mains DISCONNECTED (the opto/LED share the ISP lines)."
		(exclude_from_sim no)
		(at 20 78.74 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "551c3c50-e2d8-5db0-98c2-913f3cd6e11e")
	)
	(text
		"PART NOTES (VERIFY = check against vendor datasheet before release)\nU1: Runs at 5 V. Reads LD2410B OUT (3.3 V logic: VIH@5V = 3.0 V, margin ~0.3 V - OK). 9.6 MHz int. RC.\nC1: MCU decoupling, close to pin 8\nRR1: RESET pull-up (ISP needs RESET released)\nC3: DNP: RESET noise cap; keep small or omit so ISP works"
		(exclude_from_sim no)
		(at 219.71 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bd3eae9b-bf60-57c6-b1b0-e937c1685027")
	)
)
