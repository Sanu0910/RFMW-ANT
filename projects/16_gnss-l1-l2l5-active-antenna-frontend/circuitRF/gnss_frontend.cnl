; gnss_frontend.cnl - Project 16 GNSS L1 + L2/L5 active antenna front end
; generated by Scripts/build_circuitrf.py; run: circuitRF sparam gnss_frontend.cnl
; ports: 1 = L1 virtual RHCP input, 2 = L2/L5 virtual RHCP input, 3 = RF output (to receiver)
Term:P1  in_l1  0  Num=1  Z=50
Term:P2  in_l2  0  Num=2  Z=50
Term:P3  rf_out  0  Num=3  Z=50
; ===== L1 branch =====
SnP:CP_L1  in_l1  L1_lhcp  L1_fa  L1_fb  NumPorts=4  File="../Touchstone/PatchCP_ideal_RHCP_feed.s4p"
R:RLHCP_L1  L1_lhcp  0  R=50 Ohm
SnP:HYB_L1  L1_h1  L1_h2  L1_fa  L1_fb  NumPorts=4  File="../Touchstone/HC125A.s4p"
R:RISO_L1  L1_h2  0  R=50 Ohm
; LNA stage L1A: DC block -> TQP3M9037 -> bias tee -> DC block (Qorvo eval values)
C:C1_L1A  L1_h1  L1A_c1  C=100 pF
L:ESL1_L1A  L1A_c1  L1A_c1b  L=0.25 nH
R:ESR1_L1A  L1A_c1b  L1A_in  R=0.15 Ohm
SnP:U_L1A  L1A_in  L1A_out  NumPorts=2  File="../Touchstone/TQP3M9037_5V.s2p"
L:LCHK_L1A  L1A_out  L1A_l1  L=18 nH
R:RCHK_L1A  L1A_l1  L1A_vdd  R=3.9584 Ohm
C:CPAR_L1A  L1A_out  L1A_vdd  C=0.12 pF
C:C3_L1A  L1A_vdd  L1A_c3  C=100 pF
L:ESL3_L1A  L1A_c3  L1A_c3b  L=0.4 nH
R:ESR3_L1A  L1A_c3b  0  R=0.1 Ohm
C:C2_L1A  L1A_out  L1A_c2  C=100 pF
L:ESL2_L1A  L1A_c2  L1A_c2b  L=0.25 nH
R:ESR2_L1A  L1A_c2b  L1_s1i  R=0.15 Ohm
SnP:SAW1_L1  L1_s1i  L1_s1o  NumPorts=2  File="../Touchstone/B7504.s2p"
; LNA stage L1B: DC block -> TQP3M9037 -> bias tee -> DC block (Qorvo eval values)
C:C1_L1B  L1_s1o  L1B_c1  C=100 pF
L:ESL1_L1B  L1B_c1  L1B_c1b  L=0.25 nH
R:ESR1_L1B  L1B_c1b  L1B_in  R=0.15 Ohm
SnP:U_L1B  L1B_in  L1B_out  NumPorts=2  File="../Touchstone/TQP3M9037_5V.s2p"
L:LCHK_L1B  L1B_out  L1B_l1  L=18 nH
R:RCHK_L1B  L1B_l1  L1B_vdd  R=3.9584 Ohm
C:CPAR_L1B  L1B_out  L1B_vdd  C=0.12 pF
C:C3_L1B  L1B_vdd  L1B_c3  C=100 pF
L:ESL3_L1B  L1B_c3  L1B_c3b  L=0.4 nH
R:ESR3_L1B  L1B_c3b  0  R=0.1 Ohm
C:C2_L1B  L1B_out  L1B_c2  C=100 pF
L:ESL2_L1B  L1B_c2  L1B_c2b  L=0.25 nH
R:ESR2_L1B  L1B_c2b  L1_s2i  R=0.15 Ohm
SnP:SAW2_L1  L1_s2i  L1_out  NumPorts=2  File="../Touchstone/B7504.s2p"

; ===== L2 branch =====
SnP:CP_L2  in_l2  L2_lhcp  L2_fa  L2_fb  NumPorts=4  File="../Touchstone/PatchCP_ideal_RHCP_feed.s4p"
R:RLHCP_L2  L2_lhcp  0  R=50 Ohm
SnP:HYB_L2  L2_h1  L2_h2  L2_fa  L2_fb  NumPorts=4  File="../Touchstone/HC125A.s4p"
R:RISO_L2  L2_h2  0  R=50 Ohm
; LNA stage L2A: DC block -> TQP3M9037 -> bias tee -> DC block (Qorvo eval values)
C:C1_L2A  L2_h1  L2A_c1  C=100 pF
L:ESL1_L2A  L2A_c1  L2A_c1b  L=0.25 nH
R:ESR1_L2A  L2A_c1b  L2A_in  R=0.15 Ohm
SnP:U_L2A  L2A_in  L2A_out  NumPorts=2  File="../Touchstone/TQP3M9037_5V.s2p"
L:LCHK_L2A  L2A_out  L2A_l1  L=18 nH
R:RCHK_L2A  L2A_l1  L2A_vdd  R=3.9584 Ohm
C:CPAR_L2A  L2A_out  L2A_vdd  C=0.12 pF
C:C3_L2A  L2A_vdd  L2A_c3  C=100 pF
L:ESL3_L2A  L2A_c3  L2A_c3b  L=0.4 nH
R:ESR3_L2A  L2A_c3b  0  R=0.1 Ohm
C:C2_L2A  L2A_out  L2A_c2  C=100 pF
L:ESL2_L2A  L2A_c2  L2A_c2b  L=0.25 nH
R:ESR2_L2A  L2A_c2b  L2_s1i  R=0.15 Ohm
SnP:SAW1_L2  L2_s1i  L2_s1o  NumPorts=2  File="../Touchstone/B8889_matched.s2p"
; LNA stage L2B: DC block -> TQP3M9037 -> bias tee -> DC block (Qorvo eval values)
C:C1_L2B  L2_s1o  L2B_c1  C=100 pF
L:ESL1_L2B  L2B_c1  L2B_c1b  L=0.25 nH
R:ESR1_L2B  L2B_c1b  L2B_in  R=0.15 Ohm
SnP:U_L2B  L2B_in  L2B_out  NumPorts=2  File="../Touchstone/TQP3M9037_5V.s2p"
L:LCHK_L2B  L2B_out  L2B_l1  L=18 nH
R:RCHK_L2B  L2B_l1  L2B_vdd  R=3.9584 Ohm
C:CPAR_L2B  L2B_out  L2B_vdd  C=0.12 pF
C:C3_L2B  L2B_vdd  L2B_c3  C=100 pF
L:ESL3_L2B  L2B_c3  L2B_c3b  L=0.4 nH
R:ESR3_L2B  L2B_c3b  0  R=0.1 Ohm
C:C2_L2B  L2B_out  L2B_c2  C=100 pF
L:ESL2_L2B  L2B_c2  L2B_c2b  L=0.25 nH
R:ESR2_L2B  L2B_c2b  L2_s2i  R=0.15 Ohm
SnP:SAW2_L2  L2_s2i  L2_out  NumPorts=2  File="../Touchstone/B8889_matched.s2p"

; ===== combiner =====
SnP:DXP  rf_out  L1_out  L2_out  NumPorts=3  File="../Touchstone/DXP02A.s3p"

analysis SP1 type=sparam start=0.6 stop=2.2 npts=3201 Unit=GHz
